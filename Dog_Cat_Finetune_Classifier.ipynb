      "source": [
        "import torch\n",
        "import torch.utils.data\n",
        "import math\n",
        "import sys\n",
        "import time\n",
        "from coco_eval import CocoEvaluator\n",
        "from pycocotools.coco import COCO\n",
        "import contextlib\n",
        "import io\n",
        "\n",
        "# 1. 將 Dataset 轉換為 COCO 標準 API 格式\n",
        "def get_coco_api_from_dataset_fixed(dataset):\n",
        "    ds_ref = dataset\n",
        "\n",
        "    # 嘗試抓取類別清單\n",
        "    classes = None\n",
        "    temp_ds = dataset\n",
        "    for _ in range(10):\n",
        "        if hasattr(temp_ds, 'classes'):\n",
        "            classes = temp_ds.classes\n",
        "            break\n",
        "        if hasattr(temp_ds, 'dataset'):\n",
        "            temp_ds = temp_ds.dataset\n",
        "\n",
        "    # 如果找不到，就用預設的\n",
        "    if classes is None:\n",
        "        classes = ['cat', 'dog']\n",
        "\n",
        "    dataset_coco = []\n",
        "    annotations = []\n",
        "    ann_id = 1\n",
        "\n",
        "    # 建立 COCO 類別結構\n",
        "    categories = []\n",
        "    for i, name in enumerate(classes):\n",
        "        categories.append({\"id\": i + 1, \"name\": name})\n",
        "\n",
        "    # print(f\"正在轉換 COCO 格式 (共 {len(dataset)} 筆)...\")\n",
        "\n",
        "    for img_idx in range(len(dataset)):\n",
        "        img, targets = dataset[img_idx]\n",
        "        image_id = targets[\"image_id\"]\n",
        "\n",
        "        # 強制轉型 ID\n",
        "        if hasattr(image_id, 'item'):\n",
        "            image_id = image_id.item()\n",
        "        image_id = int(image_id)\n",
        "\n",
        "\n",
        "        # 圖片基礎資訊\n",
        "        dataset_coco.append({\n",
        "            \"id\": image_id,\n",
        "            \"height\": img.shape[-2],\n",
        "            \"width\": img.shape[-1]\n",
        "        })\n",
        "\n",
        "        # 標註資訊轉換 [xmin, ymin, xmax, ymax] -> [x, y, w, h]\n",
        "        bboxes = targets[\"boxes\"]\n",
        "        labels = targets[\"labels\"]\n",
        "\n",
        "        # 預防性處理 area/iscrowd\n",
        "        areas = targets[\"area\"] if \"area\" in targets else torch.zeros(len(bboxes))\n",
        "        iscrowd = targets[\"iscrowd\"] if \"iscrowd\" in targets else torch.zeros(len(bboxes))\n",
        "\n",
        "        for i in range(len(bboxes)):\n",
        "            ann = {}\n",
        "            ann[\"image_id\"] = image_id\n",
        "            ann[\"bbox\"] = bboxes[i].tolist()\n",
        "            ann[\"category_id\"] = int(labels[i])\n",
        "            ann[\"id\"] = ann_id\n",
        "\n",
        "            # 轉換框框格式 [x1, y1, x2, y2] -> [x, y, w, h]\n",
        "            xmin, ymin, xmax, ymax = ann[\"bbox\"]\n",
        "            ann[\"bbox\"] = [xmin, ymin, xmax - xmin, ymax - ymin]\n",
        "            ann[\"area\"] = float(areas[i]) if i < len(areas) else (xmax-xmin)*(ymax-ymin)\n",
        "            ann[\"iscrowd\"] = int(iscrowd[i]) if i < len(iscrowd) else 0\n",
        "\n",
        "            annotations.append(ann)\n",
        "            ann_id += 1\n",
        "\n",
        "    # 封裝並回傳 COCO 物件\n",
        "    coco_ds = COCO()\n",
        "    coco_ds.dataset = {}\n",
        "    coco_ds.dataset[\"images\"] = dataset_coco\n",
        "    coco_ds.dataset[\"annotations\"] = annotations\n",
        "    coco_ds.dataset[\"categories\"] = categories\n",
        "\n",
        "    # 補上 info 和 licenses\n",
        "    coco_ds.dataset[\"info\"] = {\"description\": \"Cat Dog Dataset\", \"year\": 2026}\n",
        "    coco_ds.dataset[\"licenses\"] = []\n",
        "\n",
        "    # 隱藏過多資訊\n",
        "    with contextlib.redirect_stdout(io.StringIO()):\n",
        "        coco_ds.createIndex()\n",
        "\n",
        "    return coco_ds\n",
        "\n",
        "# 2. 客製化評估函式：計算 mAP 指標\n",
        "@torch.inference_mode()\n",
        "def my_evaluate(model, data_loader, device):\n",
        "    model.eval()\n",
        "\n",
        "    # 建立標準答案\n",
        "    coco = get_coco_api_from_dataset_fixed(data_loader.dataset)\n",
        "\n",
        "    # 初始化評分器\n",
        "    coco_evaluator = CocoEvaluator(coco, [\"bbox\"])\n",
        "\n",
        "    for images, targets in data_loader:\n",
        "        images = list(img.to(device) for img in images)\n",
        "\n",
        "        if torch.cuda.is_available():\n",
        "            torch.cuda.synchronize()\n",
        "\n",
        "        outputs = model(images)\n",
        "        outputs = [{k: v.to(torch.device(\"cpu\")) for k, v in t.items()} for t in outputs]\n",
        "\n",
        "        res = {}\n",
        "        for target, output in zip(targets, outputs):\n",
        "            # 確保預測結果的 ID 也是 Int\n",
        "            image_id = target[\"image_id\"]\n",
        "            if hasattr(image_id, 'item'):\n",
        "                image_id = image_id.item()\n",
        "            res[int(image_id)] = output # 確保 ID 對上\n",
        "\n",
        "        coco_evaluator.update(res)\n",
        "\n",
        "    # 計算並彙整結果\n",
        "    coco_evaluator.synchronize_between_processes()\n",
        "    coco_evaluator.accumulate()\n",
        "    # coco_evaluator.summarize()\n",
        "\n",
        "    # 隱藏過多資訊\n",
        "    with contextlib.redirect_stdout(io.StringIO()):\n",
        "        coco_evaluator.summarize()\n",
        "\n",
        "    # 取出 mAP 分數\n",
        "    stats = coco_evaluator.coco_eval['bbox'].stats\n",
        "    mAP = stats[0]\n",
        "    mAP50 = stats[1]\n",
        "\n",
        "    print(f\"Eval Result | mAP(50-95): {mAP:.4f} | mAP(50): {mAP50:.4f}\")\n",
        "\n",
        "    return coco_evaluator"
      ]
    },
