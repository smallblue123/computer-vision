      "source": [
        "import albumentations as A\n",
        "from albumentations.pytorch import ToTensorV2\n",
        "import torch\n",
        "from torch.utils.data import DataLoader, Subset\n",
        "\n",
        "# 1. 定義訓練集增強策略\n",
        "def get_train_transform():\n",
        "    return A.Compose([\n",
        "        # 幾何變換\n",
        "        A.HorizontalFlip(p=0.5), # 水平翻轉\n",
        "        # 旋轉與縮放\n",
        "        A.Affine(\n",
        "                translate_percent={'x': (-0.0625, 0.0625), 'y': (-0.0625, 0.0625)},\n",
        "                scale=(0.9, 1.1),\n",
        "                rotate=(-15, 15),\n",
        "                p=0.5\n",
        "                ),\n",
        "        # # 像素變換 (只改畫質)\n",
        "        # A.GaussNoise(p=0.3), # 程式加入高斯雜訊\n",
        "\n",
        "        # # 模擬模糊 (手抖/失焦\n",
        "        # A.OneOf([\n",
        "        #     A.MotionBlur(p=0.2),\n",
        "        #     A.MedianBlur(blur_limit=3, p=0.1),\n",
        "        #     A.Blur(blur_limit=3, p=0.1),\n",
        "        # ], p=0.3),\n",
        "\n",
        "        # 色彩變換\n",
        "        A.OneOf([\n",
        "            A.RandomBrightnessContrast(\n",
        "                brightness_limit=0.2,\n",
        "                contrast_limit=0.2,\n",
        "                p=1.0\n",
        "            ),\n",
        "            A.HueSaturationValue(\n",
        "                hue_shift_limit=20,\n",
        "                sat_shift_limit=30,\n",
        "                val_shift_limit=20,\n",
        "                p=1.0\n",
        "            ),\n",
        "        ], p=0.5),\n",
        "        # 輸出轉換\n",
        "        ToTensorV2()\n",
        "    ],\n",
        "    # 設定 Bounding Box 格式\n",
        "    bbox_params=A.BboxParams(\n",
        "        format='pascal_voc',\n",
        "        label_fields=['class_labels'],\n",
        "        min_visibility=0.3\n",
        "    ))\n",
        "\n",
        "# 2. 定義測試集轉換 (僅正規化)\n",
        "def get_test_transform():\n",
        "    return A.Compose([\n",
        "        ToTensorV2()\n",
        "    ], bbox_params=A.BboxParams(format='pascal_voc', label_fields=['class_labels']))\n",
        "\n",
        "# 3. 系統建立資料集與切分\n",
        "\n",
        "# 建立兩個 dataset 物件，分別用於訓練與測試\n",
        "total_ds = CatDogDataset(base_path, transforms=get_train_transform())\n",
        "test_ds = CatDogDataset(base_path, transforms=get_test_transform())\n",
        "\n",
        "# 計算 8:1:1 的切分比例\n",
        "total_len = len(total_ds)\n",
        "train_size = int(0.8 * total_len)\n",
        "val_size = int(0.1 * total_len)\n",
        "test_size  = total_len - train_size - val_size\n",
        "\n",
        "# 固定隨機種子以確保實驗可重現性\n",
        "torch.manual_seed(42)\n",
        "indices = torch.randperm(total_len).tolist()\n",
        "\n",
        "# 切分索引\n",
        "train_indices = indices[:train_size]\n",
        "val_indices = indices[train_size : train_size + val_size]\n",
        "test_indices = indices[train_size + val_size :]\n",
        "\n",
        "# 建立 Subset：訓練集使用有增強的 ds，驗證與測試集使用原始無增強的 ds\n",
        "train_dataset = Subset(total_ds, train_indices)\n",
        "val_dataset   = Subset(test_ds, val_indices)\n",
        "test_dataset  = Subset(test_ds, test_indices)\n",
        "\n",
        "print(f\"資料集準備完成！總數: {total_len}\")\n",
        "print(f\" - Train: {len(train_dataset)} 張\")\n",
        "print(f\" - Val:  {len(val_dataset)} 張\")\n",
        "print(f\" - Test:  {len(test_dataset)} 張\")\n",
        "\n",
        "# 4. 定義 Collate Function (處理批次內不同長度的標籤資料)\n",
        "def collate_fn(batch):\n",
        "    return tuple(zip(*batch))\n",
        "\n",
        "# 建立批次讀取器\n",
        "train_loader = DataLoader(\n",
        "    train_dataset,\n",
        "    batch_size=4,\n",
        "    shuffle=True,\n",
        "    num_workers=2,\n",
        "    collate_fn=collate_fn,\n",
        "    pin_memory=True,\n",
        "    persistent_workers=True\n",
        ")\n",
        "\n",
        "val_loader   = DataLoader(\n",
        "    val_dataset,\n",
        "    batch_size=4,\n",
        "    shuffle=False,\n",
        "    num_workers=2,\n",
        "    collate_fn=collate_fn,\n",
        "    pin_memory=True,\n",
        "    persistent_workers=True\n",
        ")\n",
        "\n",
        "test_loader = DataLoader(\n",
        "    test_dataset,\n",
        "    batch_size=4,\n",
        "    shuffle=False,\n",
        "    num_workers=2,\n",
        "    collate_fn=collate_fn,\n",
        "    pin_memory=True,\n",
        "    # persistent_workers=True\n",
        ")\n",
        "\n",
        "print(\"DataLoader 更新完畢，準備開始訓練！\")"
      ]
    },
