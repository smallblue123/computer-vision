        "import torch\n",
        "import torchvision\n",
        "from torchvision.models.detection import fasterrcnn_resnet50_fpn\n",
        "\n",
        "# --- 1. 定義類別 ID 翻譯包裝器 ---\n",
        "# 此類別用於封裝官方模型，將其預測結果轉換為本專案定義的格式\n",
        "class StockModelWrapper(torch.nn.Module):\n",
        "    def __init__(self, stock_model, user_classes, device):\n",
        "        super().__init__()\n",
        "        self.stock_model = stock_model\n",
        "        self.device = device\n",
        "        self.user_classes = user_classes\n",
        "\n",
        "        # COCO 預訓練模型的原始類別定義 (17 為貓, 18 為狗)\n",
        "        self.coco_map = {17: 'cat', 18: 'dog'}\n",
        "\n",
        "        # 建立動態對照表: {COCO_ID: USER_ID}\n",
        "        self.id_mapping = {}\n",
        "\n",
        "        for coco_id, coco_name in self.coco_map.items():\n",
        "            try:\n",
        "                # 尋找 COCO 類別在使用者定義類別清單中的索引\n",
        "                user_idx = self.user_classes.index(coco_name)\n",
        "                user_id = user_idx + 1\n",
        "                self.id_mapping[coco_id] = user_id\n",
        "                print(f\" - COCO {coco_id} ({coco_name}) 對應到 -> User ID {user_id}\")\n",
        "            except ValueError:\n",
        "                print(f\" - 資料集沒有 {coco_name}，將忽略此類別。\")\n",
        "\n",
        "    def eval(self):\n",
        "        self.stock_model.eval()\n",
        "\n",
        "    def to(self, device):\n",
        "        self.stock_model.to(device)\n",
        "        return self\n",
        "\n",
        "    def __call__(self, images, targets=None):\n",
        "        # 1. 取得原廠模型的原始預測\n",
        "        with torch.no_grad():\n",
        "            raw_outputs = self.stock_model(images)\n",
        "\n",
        "        new_outputs = []\n",
        "        for out in raw_outputs:\n",
        "            # 2. 過濾並轉換標籤\n",
        "            keep_indices = []\n",
        "            new_labels = []\n",
        "\n",
        "            for i, label in enumerate(out['labels']):\n",
        "                label_val = label.item()\n",
        "                if label_val in self.id_mapping:\n",
        "                    # 若預測類別屬於目標類別 (貓或狗)，則保留索引並執行 ID 翻譯\n",
        "                    keep_indices.append(i)\n",
        "                    new_labels.append(self.id_mapping[label_val])\n",
        "\n",
        "            # 3. 處理無符合結果的情況：若沒抓到目標，回傳空 Tensor 避免程式出錯\n",
        "            if len(keep_indices) == 0:\n",
        "                new_outputs.append({\n",
        "                    'boxes': torch.empty((0, 4), device=self.device),\n",
        "                    'labels': torch.empty((0,), dtype=torch.int64, device=self.device),\n",
        "                    'scores': torch.empty((0,), device=self.device)\n",
        "                })\n",
        "                continue\n",
        "\n",
        "            # 4. 提取保留的資料並進行初步分數篩選\n",
        "            keep_tensor = torch.as_tensor(keep_indices, device=self.device)\n",
        "            scores = out['scores'][keep_tensor]\n",
        "\n",
        "            # 設定基礎閾值 (0.05) 以移除明顯錯誤的預測\n",
        "            mask = scores > 0.05\n",
        "            final_indices = keep_tensor[mask]\n",
        "            final_new_labels = torch.tensor(new_labels, device=self.device)[mask] # 對應的 labels 也要篩選\n",
        "\n",
        "            new_outputs.append({\n",
        "                'boxes': out['boxes'][final_indices],\n",
        "                'labels': final_new_labels,\n",
        "                'scores': out['scores'][final_indices]\n",
        "            })\n",
        "\n",
        "        return new_outputs\n",
        "\n",
        "# --- 2. 準備評估對象 ---\n",
        "\n",
        "classes = total_ds.classes\n",
        "print(f\"類別定義: {classes}\")\n",
        "\n",
        "# # 選手 A: Fine-tuned 模型\n",
        "# print(\"載入 Fine-tuned 模型...\")\n",
        "# # model.load_state_dict(torch.load('best_model.pt')) # 確保是載入最佳權重\n",
        "# model.eval()\n",
        "\n",
        "# 選手 B: 載入官方原廠模型並安裝 ID 翻譯機\n",
        "print(\"載入原廠模型並安裝翻譯機...\")\n",
        "raw_stock_model = fasterrcnn_resnet50_fpn(weights=\"DEFAULT\")\n",
        "stock_model_wrapped = StockModelWrapper(raw_stock_model, classes, device)\n",
        "stock_model_wrapped.to(device)\n",
        "stock_model_wrapped.eval()\n",
        "\n",
        "# --- 3. 執行 mAP 性能測試 ---\n",
        "\n",
        "print(\"\\n\" + \"=\"*50)\n",
        "print(\"ROUND 1: Fine-tuned 模型表現\")\n",
        "print(\"=\"*50)\n",
        "# 使用寫好的評估函式\n",
        "ft_evaluator = my_evaluate(model, test_loader, device)\n",
        "ft_stats = ft_evaluator.coco_eval['bbox'].stats\n",
        "\n",
        "print(\"\\n\" + \"=\"*50)\n",
        "print(\"ROUND 2: 原廠模型表現 (只看貓狗)\")\n",
        "print(\"=\"*50)\n",
        "stock_evaluator = my_evaluate(stock_model_wrapped, test_loader, device)\n",
        "stock_stats = stock_evaluator.coco_eval['bbox'].stats\n",
        "\n",
        "# --- 4. 生成數據比較表 ---\n",
        "ft_map = ft_stats[0]\n",
        "ft_map50 = ft_stats[1]\n",
        "stock_map = stock_stats[0]\n",
        "stock_map50 = stock_stats[1]\n",
        "\n",
        "# 計算指標差異\n",
        "diff = ft_map - stock_map\n",
        "diff50 = ft_map50 - stock_map50\n",
        "\n",
        "# 輸出最終對照表格\n",
        "print(f\"\\n最終比較結果 (Test Set Comparison):\")\n",
        "print(f\"{'='*70}\")\n",
        "print(f\"{'指標 (Metric)':<16} | {'Fine-Tuned':<12} | {'Stock COCO':<12} | {'差異 (Diff)':<16}\")\n",
        "print(f\"{'-'*70}\")\n",
        "\n",
        "# 顯示 mAP (50-95)\n",
        "pct = (diff / stock_map * 100) if stock_map > 0 else 0\n",
        "sign = \"+\" if diff > 0 else \"\"\n",
        "print(f\"{'mAP (50-95)':<16} | {ft_map:<12.4f} | {stock_map:<12.4f} | {sign}{diff:.4f} ({sign}{pct:.1f}%)\")\n",
        "\n",
        "# 顯示 mAP (50)\n",
        "pct50 = (diff50 / stock_map50 * 100) if stock_map50 > 0 else 0\n",
        "sign50 = \"+\" if diff50 > 0 else \"\"\n",
        "print(f\"{'mAP (50)':<16} | {ft_map50:<12.4f} | {stock_map50:<12.4f} | {sign50}{diff50:.4f} ({sign50}{pct50:.1f}%)\")\n",
        "\n",
        "print(f\"{'='*70}\")"
      ]
    },
