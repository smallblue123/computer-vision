        "# ==========================================\n",
        "# 分析原廠模型 (Stock Model)\n",
        "# ==========================================\n",
        "import torchvision\n",
        "from torchvision.models.detection import fasterrcnn_resnet50_fpn\n",
        "\n",
        "print(\"\\n\" + \"=\"*50)\n",
        "print(\"正在載入原廠模型 (Stock Model) 進行對照...\")\n",
        "print(\"=\"*50)\n",
        "\n",
        "# 取得資料集定義的類別名稱 (cat, dog)\n",
        "classes = total_ds.classes\n",
        "\n",
        "# 1. 載入乾淨的原廠模型\n",
        "raw_stock_model = fasterrcnn_resnet50_fpn(weights=\"DEFAULT\")\n",
        "\n",
        "# 2. 套用類別翻譯器\n",
        "stock_model_wrapped = StockModelWrapper(raw_stock_model, classes, device)\n",
        "stock_model_wrapped.to(device)\n",
        "\n",
        "# 3. 收集驗證集推論數據\n",
        "stock_val_data = collect_inference_data(stock_model_wrapped, val_loader, device)\n",
        "\n",
        "# 4. 尋找最佳信心度門檻\n",
        "stock_best_thresh = find_best_threshold_strict(stock_val_data, iou_threshold=0.01)\n",
        "\n",
        "# 5. 收集測試集數據\n",
        "stock_test_data = collect_inference_data(stock_model_wrapped, test_loader, device)\n",
        "\n",
        "# 6. 計算混淆矩陣\n",
        "stock_cm = compute_confusion_matrix(\n",
        "    stock_test_data,\n",
        "    classes,\n",
        "    score_threshold=stock_best_thresh,\n",
        "    iou_threshold=0.01\n",
        ")\n",
        "\n",
        "# 7. 畫圖\n",
        "plot_confusion_matrix_heatmap(stock_cm, classes)"
      ]
    }
