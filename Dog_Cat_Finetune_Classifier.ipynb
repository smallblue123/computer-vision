        "    val_counts = [counts[\"Val\"][i] for i in class_indices]\n",
        "    test_counts = [counts[\"Test\"][i] for i in class_indices]\n",
        "\n",
        "    # 4. 繪製分組長條圖\n",
        "    x = np.arange(len(classes))\n",
