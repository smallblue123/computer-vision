        "\n",
        "    fig, ax = plt.subplots(figsize=(15, 6))\n",
        "\n",
        "    # 繪製不同資料集的長條圖\n",
        "    rects1 = ax.bar(x - width, train_counts, width, label='Train')\n",
        "    rects2 = ax.bar(x, val_counts, width, label='Val')\n",
        "    rects3 = ax.bar(x + width, test_counts, width, label='Test')\n",
        "\n",
        "    # 設定圖表標籤與標題\n",
        "    ax.set_ylabel('Object Counts')\n",
        "    ax.set_title('Class Distribution in Train / Val / Test Sets')\n",
        "    ax.set_xticks(x)\n",
