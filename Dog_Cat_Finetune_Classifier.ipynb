        "### 定義資料集類別 (Dataset Class)\n",
        "\n",
        "* **功能大綱**：建立繼承自 PyTorch Dataset 的自定義類別，完整處理 Pascal VOC 標註格式。包含解析 XML 標籤、讀取影像、整合 Albumentations 資料增強，並計算模型所需的 Bounding Box 面積與 crowd 資訊。\n",
        "* **關鍵重點**：解析標籤與類別映射（cat: 1, dog: 2）、處理影像副檔名相容性、執行資料增強轉換，並確保輸出為符合模型要求的 Target 字典格式。"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 2,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "execution": {
          "iopub.execute_input": "2026-01-26T06:24:26.250823Z",
          "iopub.status.busy": "2026-01-26T06:24:26.250130Z",
          "iopub.status.idle": "2026-01-26T06:24:28.845576Z",
          "shell.execute_reply": "2026-01-26T06:24:28.844940Z",
          "shell.execute_reply.started": "2026-01-26T06:24:26.250792Z"
        },
        "id": "qrmX3aOgp6Tm",
        "outputId": "81b90331-75ea-4c32-bfb8-699eee962c1f",
        "trusted": true
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Dataset 類別定義完成。\n"
          ]
        }
      ],
      "source": [
        "import torch\n",
        "from torch.utils.data import Dataset\n",
        "import torchvision.transforms as T\n",
        "from PIL import Image\n",
        "import os\n",
        "import xml.etree.ElementTree as ET\n",
        "import albumentations as A\n",
        "from albumentations.pytorch import ToTensorV2\n",
        "\n",
        "class CatDogDataset(Dataset):\n",
        "    def __init__(self, root_dir, transforms=None):\n",
        "        self.root_dir = root_dir\n",
        "        self.transforms = transforms\n",
        "\n",
        "        # 設定 PASCAL VOC 的標準路徑結構\n",
        "        self.img_dir = os.path.join(root_dir, 'images')\n",
        "        self.xml_dir = os.path.join(root_dir, 'annotations')\n",
        "\n",
        "        # 讀取所有 XML 檔案列表並排序，確保索引一致，過濾非 xml 的檔案\n",
        "        self.xml_list = sorted([f for f in os.listdir(self.xml_dir) if f.endswith('.xml')])\n",
        "\n",
        "        # 定義類別 (不含背景)\n",
        "        self.classes = ['cat', 'dog']\n",
        "\n",
        "        # 建立類別對應表 (Name -> ID)，背景 ID 通常預設為 0\n",
        "        self.class_to_id = {cls_name: i+1 for i, cls_name in enumerate(self.classes)}\n",
        "\n",
        "        print(f\"資料集初始化完成，共有 {len(self.xml_list)} 張圖片。\")\n",
        "        print(f\"檢查類別數: {len(self.classes)}\")\n",
        "\n",
        "    def __len__(self):\n",
        "        # 回傳資料集總筆數\n",
        "        return len(self.xml_list)\n",
        "\n",
        "    def __getitem__(self, idx):\n",
        "        # 1. 根據索引取得 XML 檔案路徑\n",
        "        xml_file = self.xml_list[idx]\n",
        "        xml_path = os.path.join(self.xml_dir, xml_file)\n",
        "\n",
        "        # 2. 解析 XML\n",
        "        tree = ET.parse(xml_path)\n",
        "        root = tree.getroot()\n",
        "\n",
        "        # 3. 找出對應的圖片檔名並讀取，替換副檔名\n",
        "        img_name = xml_file.replace('.xml', '.png')\n",
        "        img_path = os.path.join(self.img_dir, img_name)\n",
        "\n",
        "        # 如果找不到 png，試試看 jpg\n",
        "        if not os.path.exists(img_path):\n",
        "            img_path = img_path.replace('.png', '.jpg')\n",
        "\n",
        "        # 將圖片轉為 RGB，確保維度一致\n",
        "        img = Image.open(img_path).convert(\"RGB\")\n",
        "        img = np.array(img)\n",
        "\n",
        "        # 4. 提取 Bounding Box 資訊\n",
        "        boxes = []\n",
        "        labels = []\n",
        "\n",
        "        # 遍歷 XML 中所有的 <object>\n",
        "        for obj in root.findall('object'):\n",
        "            name = obj.find('name').text\n",
        "\n",
        "            # 如果類別不在我們的清單中，就跳過\n",
        "            if name not in self.class_to_id:\n",
        "                continue\n",
        "\n",
        "            label = self.class_to_id[name]\n",
        "\n",
        "            # 讀取座標 (xmin, ymin, xmax, ymax)\n",
        "            bndbox = obj.find('bndbox')\n",
        "            xmin = float(bndbox.find('xmin').text)\n",
        "            ymin = float(bndbox.find('ymin').text)\n",
        "            xmax = float(bndbox.find('xmax').text)\n",
        "            ymax = float(bndbox.find('ymax').text)\n",
        "\n",
        "            boxes.append([xmin, ymin, xmax, ymax])\n",
        "            labels.append(label)\n",
        "\n",
        "        # 執行 Albumentations 資料增強\n",
        "        if self.transforms:\n",
        "            # 將圖片、框框、標籤一起丟進去轉換\n",
        "            transformed = self.transforms(image=img, bboxes=boxes, class_labels=labels)\n",
        "\n",
        "            # 取出轉換後的結果\n",
        "            img = transformed['image']\n",
        "            boxes = transformed['bboxes']\n",
        "            labels = transformed['class_labels']\n",
        "\n",
        "        # 若影像為 uint8 格式，則進行歸一化處理\n",
        "        if isinstance(img, torch.Tensor) and img.dtype == torch.uint8:\n",
        "            img = img.float() / 255.0\n",
        "\n",
        "        # 轉換為 Tensor\n",
        "        boxes_tensor = torch.as_tensor(boxes, dtype=torch.float32)\n",
        "        labels_tensor = torch.as_tensor(labels, dtype=torch.int64)\n",
        "\n",
        "        # 處理空框情況\n",
        "        if len(boxes_tensor) == 0:\n",
        "            boxes_tensor = torch.zeros((0, 4), dtype=torch.float32)\n",
        "\n",
        "        image_id = torch.tensor([idx])\n",
        "\n",
        "        # 計算 Bounding Box 面積 (area)\n",
        "        if len(boxes_tensor) > 0:\n",
        "            area = (boxes_tensor[:, 3] - boxes_tensor[:, 1]) * (boxes_tensor[:, 2] - boxes_tensor[:, 0])\n",
        "        else:\n",
        "            area = torch.as_tensor([], dtype=torch.float32)\n",
        "\n",
        "        # 建立 iscrowd\n",
        "        num_objs = len(boxes_tensor)\n",
        "        iscrowd = torch.zeros((num_objs,), dtype=torch.int64)\n",
        "\n",
        "        # 封裝成模型所需的 Target 字典\n",
        "        target = {}\n",
        "        target[\"boxes\"] = boxes_tensor\n",
        "        target[\"labels\"] = labels_tensor\n",
        "        target[\"image_id\"] = image_id\n",
        "        target[\"area\"] = area\n",
        "        target[\"iscrowd\"] = iscrowd\n",
        "\n",
        "        return img, target\n",
        "\n",
        "print(\"Dataset 類別定義完成。\")"
      ]
    },
    {
