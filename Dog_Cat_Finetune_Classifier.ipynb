      "source": [
        "# --- 1. 資料收集函式 (只跑一次 GPU) ---\n",
        "def collect_inference_data(model, data_loader, device):\n",
        "    \"\"\"\n",
        "    執行推論並收集所有原始數據\n",
        "    \"\"\"\n",
        "    model.eval()\n",
        "    results_data = []\n",
        "\n",
        "    print(\"正在收集推論數據 (Inference)...\")\n",
        "    with torch.no_grad():\n",
        "        for images, targets in tqdm(data_loader):\n",
        "            images = list(img.to(device) for img in images)\n",
        "            outputs = model(images)\n",
        "\n",
        "            for i, output in enumerate(outputs):\n",
        "                # 將數據轉回 CPU\n",
        "                results_data.append({\n",
        "                    'gt_boxes': targets[i]['boxes'].cpu(),\n",
        "                    'gt_labels': targets[i]['labels'].cpu(),\n",
        "                    'pred_boxes': output['boxes'].cpu(),\n",
        "                    'pred_scores': output['scores'].cpu(),\n",
        "                    'pred_labels': output['labels'].cpu()\n",
        "                })\n",
        "\n",
        "    return results_data\n",
        "\n",
        "# --- 2. 嚴格匹配尋找最佳門檻 ---\n",
        "def find_best_threshold_strict(results_data, iou_threshold=0.5):\n",
        "    \"\"\"\n",
        "    使用貪婪匹配邏輯尋找最佳 F1-Score 的門檻。\n",
        "    \"\"\"\n",
        "    # 測試從 0.05 到 0.95 的信心度區間\n",
        "    thresholds = np.arange(0.05, 1.0, 0.05)\n",
        "    best_f1 = 0\n",
        "    best_thresh = 0.5\n",
        "\n",
        "    print(f\"\\n{'Threshold':<10} | {'Precision':<10} | {'Recall':<10} | {'F1-Score':<10}\")\n",
        "    print(\"-\" * 46)\n",
        "\n",
        "    # 計算資料集中真實目標的總數\n",
        "    total_gt_count = sum(len(d['gt_boxes']) for d in results_data)\n",
        "\n",
        "    for thresh in thresholds:\n",
        "        global_tp = 0\n",
        "        global_fp = 0\n",
        "\n",
        "        for data in results_data:\n",
        "            gt_boxes = data['gt_boxes']\n",
        "            gt_labels = data['gt_labels']\n",
        "\n",
        "            # 過濾預測框\n",
        "            mask = data['pred_scores'] >= thresh\n",
        "            pred_boxes = data['pred_boxes'][mask]\n",
        "            pred_labels = data['pred_labels'][mask]\n",
        "\n",
        "            if len(pred_boxes) == 0:\n",
        "                continue # 這張圖沒抓到東西\n",
        "\n",
        "            if len(gt_boxes) == 0:\n",
        "                global_fp += len(pred_boxes) # 這張圖原本沒東西，卻抓到了 -> 全部誤報\n",
        "                continue\n",
        "\n",
        "            # 計算所有真實框與預測框的 IoU 矩陣\n",
        "            iou_matrix = torchvision.ops.box_iou(gt_boxes, pred_boxes)\n",
        "\n",
        "            # 尋找所有滿足 IoU 門檻的候選配對\n",
        "            matches = torch.where(iou_matrix > iou_threshold)\n",
        "            match_pairs = torch.stack(matches, dim=1)\n",
        "\n",
        "            # 依據 IoU 大小由高到低排序，優先匹配最準確的框\n",
        "            match_ious = iou_matrix[matches]\n",
        "            sorted_idx = torch.argsort(match_ious, descending=True)\n",
        "            match_pairs = match_pairs[sorted_idx]\n",
        "\n",
        "            gt_matched = set()\n",
        "            pred_matched = set()\n",
        "\n",
        "            for pair in match_pairs:\n",
        "                gt_idx, pred_idx = pair[0].item(), pair[1].item()\n",
        "                # 貪婪匹配：確保每個框只被配對一次\n",
        "                if gt_idx not in gt_matched and pred_idx not in pred_matched:\n",
        "                    # 檢查類別是否正確\n",
        "                    if gt_labels[gt_idx] == pred_labels[pred_idx]:\n",
        "                        global_tp += 1\n",
        "                        gt_matched.add(gt_idx)\n",
        "                        pred_matched.add(pred_idx)\n",
        "\n",
        "            # 剩餘未匹配的預測框計為 FP\n",
        "            global_fp += (len(pred_boxes) - len(pred_matched))\n",
        "\n",
        "        # 計算指標\n",
        "        precision = global_tp / (global_tp + global_fp + 1e-6)\n",
        "        recall = global_tp / (total_gt_count + 1e-6)\n",
        "        f1 = 2 * (precision * recall) / (precision + recall + 1e-6)\n",
        "\n",
        "        print(f\"{thresh:<10.2f} | {precision:<10.2f} | {recall:<10.2f} | {f1:<10.4f}\")\n",
        "\n",
        "        if f1 > best_f1:\n",
        "            best_f1 = f1\n",
        "            best_thresh = thresh\n",
        "\n",
        "    print(\"-\" * 46)\n",
        "    print(f\"匹配後的最佳門檻: {best_thresh:.2f}\")\n",
        "    return best_thresh\n",
        "\n",
        "# --- 3. 計算混淆矩陣 ---\n",
        "def compute_confusion_matrix(results_data, class_names, score_threshold, iou_threshold=0.5):\n",
        "    \"\"\"\n",
        "    計算包含真實類別與背景類別（Background）的混淆矩陣\n",
        "    \"\"\"\n",
        "    num_classes = len(class_names)\n",
        "    cm = np.zeros((num_classes + 1, num_classes + 1), dtype=int)\n",
        "    bg_idx = num_classes\n",
        "\n",
        "    print(f\"正在計算混淆矩陣 (Threshold={score_threshold:.2f})...\")\n",
        "\n",
        "    for data in results_data:\n",
        "        gt_boxes = data['gt_boxes']\n",
        "        gt_labels = data['gt_labels']\n",
        "\n",
        "        mask = data['pred_scores'] >= score_threshold\n",
        "        pred_boxes = data['pred_boxes'][mask]\n",
        "        pred_labels = data['pred_labels'][mask]\n",
        "\n",
        "        if len(pred_boxes) == 0 and len(gt_boxes) == 0:\n",
        "            continue\n",
        "\n",
        "        gt_matched = set()\n",
        "        pred_matched = set()\n",
        "\n",
        "        # 計算 IoU 並進行匹配\n",
        "        if len(pred_boxes) > 0 and len(gt_boxes) > 0:\n",
        "            iou_matrix = torchvision.ops.box_iou(gt_boxes, pred_boxes)\n",
        "            matches = torch.where(iou_matrix > iou_threshold)\n",
        "            match_pairs = torch.stack(matches, dim=1)\n",
        "            match_ious = iou_matrix[matches]\n",
        "            sorted_idx = torch.argsort(match_ious, descending=True)\n",
        "            match_pairs = match_pairs[sorted_idx]\n",
        "\n",
        "            for pair in match_pairs:\n",
        "                gt_idx, pred_idx = pair[0].item(), pair[1].item()\n",
        "                if gt_idx not in gt_matched and pred_idx not in pred_matched:\n",
        "                    true_cls = int(gt_labels[gt_idx]) - 1\n",
        "                    pred_cls = int(pred_labels[pred_idx]) - 1\n",
        "\n",
        "                    if 0 <= true_cls < num_classes and 0 <= pred_cls < num_classes:\n",
        "                        cm[true_cls, pred_cls] += 1\n",
        "\n",
        "                    gt_matched.add(gt_idx)\n",
        "                    pred_matched.add(pred_idx)\n",
        "\n",
        "        # 漏抓 (False Negative)：真實存在但模型預測為背景\n",
        "        for i in range(len(gt_boxes)):\n",
        "            if i not in gt_matched:\n",
        "                true_cls = int(gt_labels[i]) - 1\n",
        "                if 0 <= true_cls < num_classes:\n",
        "                    cm[true_cls, bg_idx] += 1\n",
        "\n",
        "        # 誤報 (False Positive)：背景被模型誤認為某個類別\n",
        "        for i in range(len(pred_boxes)):\n",
        "            if i not in pred_matched:\n",
        "                pred_cls = int(pred_labels[i]) - 1\n",
        "                if 0 <= pred_cls < num_classes:\n",
        "                    cm[bg_idx, pred_cls] += 1\n",
        "\n",
        "    return cm\n",
        "\n",
        "# --- 4. 畫圖函式 ---\n",
        "def plot_confusion_matrix_heatmap(cm, class_names):\n",
        "    \"\"\"\n",
        "    繪製混淆矩陣熱圖並輸出詳細的 Precision, Recall 與 F1 分數\n",
        "    \"\"\"\n",
        "    labels = class_names + ['Background']\n",
        "    plt.figure(figsize=(8, 6))\n",
        "    # 使用 seaborn 繪製帶有數值的熱圖\n",
        "    sns.heatmap(cm, annot=True, fmt='d', cmap='Blues',\n",
        "                xticklabels=labels, yticklabels=labels)\n",
        "    plt.xlabel('Predicted Label')\n",
        "    plt.ylabel('True Label')\n",
        "    plt.title('Confusion Matrix')\n",
        "    plt.show()\n",
        "\n",
        "    print(\"\\n各類別詳細指標:\")\n",
        "    print(f\"{'Class':<12} | {'Precision':<10} | {'Recall':<10} | {'F1-Score':<10}\")\n",
        "    print(\"-\" * 50)\n",
        "\n",
        "    num_classes = len(class_names)\n",
        "\n",
        "    for i in range(num_classes):\n",
        "        # TP: 對角線上的值 cm[i, i]\n",
        "        tp = cm[i, i]\n",
        "\n",
        "        # 該行扣除對角線即為誤報\n",
        "        fp = cm[:, i].sum() - tp\n",
        "\n",
        "        # 該列扣除對角線即為漏抓\n",
        "        fn = cm[i, :].sum() - tp\n",
        "\n",
        "        precision = tp / (tp + fp) if (tp + fp) > 0 else 0\n",
        "        recall = tp / (tp + fn) if (tp + fn) > 0 else 0\n",
        "        f1 = 2 * (precision * recall) / (precision + recall) if (precision + recall) > 0 else 0\n",
        "\n",
        "        print(f\"{class_names[i]:<12} | {precision:.2%}     | {recall:.2%}     | {f1:.2f}\")\n"
      ]
    },
