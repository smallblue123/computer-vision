        "# 2. 定義繪圖函式，用於顯示圖片及其標註框\n",
        "def plot_img_bbox(img_tensor, target, class_names):\n",
        "    # 將 Tensor 維度轉換為 Matplotlib 需要的格式\n",
        "    img = img_tensor.permute(1, 2, 0).numpy()\n",
        "\n",
        "    fig, ax = plt.subplots(1, figsize=(10, 8))\n",
        "    ax.imshow(img)\n",
        "\n",
        "    # 將 boxes 和 labels 轉成 numpy 陣列\n",
        "    boxes_np = target['boxes'].cpu().numpy()\n",
        "    labels_np = target['labels'].cpu().numpy()\n",
        "\n",
        "    # 畫出所有標註框\n",
        "    for box, label_id in zip(boxes_np, labels_np):\n",
        "        # 取得座標資訊\n",
        "        xmin, ymin, xmax, ymax = box\n",
        "\n",
        "        # 算出寬高\n",
        "        width = xmax - xmin\n",
        "        height = ymax - ymin\n",
        "\n",
        "        # 取得類別名稱\n",
        "        label_index = int(label_id) - 1\n",
        "\n",
        "        # 確保索引沒有超出範圍\n",
        "        if 0 <= label_index < len(class_names):\n",
        "            label_text = class_names[label_index]\n",
        "        else:\n",
        "            label_text = f\"Unknown ({label_id})\"\n",
        "\n",
        "        # 建立紅色矩形框\n",
        "        rect = patches.Rectangle(\n",
