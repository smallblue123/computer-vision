        "from tqdm.auto import tqdm\n",
        "import seaborn as sns\n",
        "# ==========================================\n",
        "# 畫混淆矩陣\n",
        "# ==========================================\n",
        "\n",
        "# 1. 建立安全的 DataLoader\n",
        "val_loader = DataLoader(\n",
        "    val_dataset,\n",
        "    batch_size=4,\n",
        "    shuffle=False,\n",
        "    num_workers=0,\n",
        "    collate_fn=collate_fn\n",
        ")\n",
        "\n",
        "# 測試集 Loader\n",
        "test_loader = DataLoader(\n",
        "    test_dataset,\n",
        "    batch_size=4,\n",
        "    shuffle=False,\n",
        "    num_workers=0,\n",
        "    collate_fn=collate_fn\n",
        ")\n",
        "\n",
        "classes = total_ds.classes\n",
        "\n",
        "# 2. 載入訓練過程中表現最好的模型\n",
        "model.load_state_dict(torch.load('best_model.pt'))\n",
        "model.to(device)\n",
        "print(\"模型載入完成\")\n",
        "\n",
        "# 3. 收集驗證集數據\n",
        "val_inference_data = collect_inference_data(model, val_loader, device)\n",
        "\n",
        "# 4. 尋找最佳信心度門檻\n",
        "best_conf_thresh = find_best_threshold_strict(val_inference_data, iou_threshold=0.5)\n",
        "\n",
        "# 5. 收集測試集數據並計算最終混淆矩陣\n",
        "test_inference_data = collect_inference_data(model, test_loader, device)\n",
        "\n",
        "# 根據剛才找到的最佳門檻，計算測試集的混淆矩陣\n",
        "final_cm = compute_confusion_matrix(\n",
        "    test_inference_data,\n",
        "    total_ds.classes,  # 請確認這跟你的 classes 對應\n",
        "    score_threshold=best_conf_thresh,\n",
        "    iou_threshold=0.5\n",
        ")\n",
        "\n",
        "# 6. 畫圖\n",
        "plot_confusion_matrix_heatmap(final_cm, classes)"
      ]
