        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "from collections import defaultdict\n",
        "\n",
        "def plot_class_distribution(dataset_dict, classes):\n",
        "    \"\"\"\n",
        "    輸入: dataset_dict = {\"Train\": train_ds, \"Val\": val_ds, \"Test\": test_ds}\n",
        "          classes = 類別名稱列表\n",
        "    \"\"\"\n",
        "    # 1. 初始化計數器，為每個資料集階段建立一個計數字典\n",
        "    counts = {name: defaultdict(int) for name in dataset_dict.keys()}\n",
        "\n",
        "    print(\"正在統計各資料集類別分佈 ...\")\n",
        "\n",
        "    # 2. 遍歷所有資料集進行統計\n",
        "    for phase, ds_obj in dataset_dict.items():\n",
        "        # 判斷傳進來的是Subset還是Dataset\n",
        "        if isinstance(ds_obj, Subset):\n",
        "            full_ds = ds_obj.dataset\n",
        "            indices = ds_obj.indices\n",
        "        else:\n",
        "            full_ds = ds_obj\n",
        "            indices = range(len(full_ds))\n",
        "\n",
        "        for idx in indices:\n",
        "            try:\n",
        "              # 嘗試直接讀 XML 標籤而不讀圖\n",
        "              xml_file = full_ds.xml_list[idx]\n",
        "              xml_path = os.path.join(full_ds.xml_dir, xml_file)\n",
        "\n",
        "              tree = ET.parse(xml_path)\n",
        "              root = tree.getroot()\n",
        "\n",
        "              for obj in root.findall('object'):\n",
        "                  name = obj.find('name').text\n",
        "                  # 轉換名稱為 ID\n",
        "                  if name in full_ds.class_to_id:\n",
        "                      label_id = full_ds.class_to_id[name]\n",
        "                      counts[phase][label_id] += 1\n",
        "            except Exception:\n",
        "              # 若 XML 解析失敗，則回退到使用 Dataset 的 __getitem__ 方法\n",
        "              _, target = full_ds[idx]\n",
        "              labels = target['labels'].numpy()\n",
        "\n",
        "              for label in labels:\n",
        "                  counts[phase][label] += 1\n",
        "\n",
        "    # 3. 準備繪圖數據\n",
        "    class_indices = np.arange(1, len(classes) + 1)\n",
