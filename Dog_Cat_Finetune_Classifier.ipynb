        "\n",
        "def diagnose_prediction_visual(dataset, model, device):\n",
        "    # 1. 從資料集取得第一張影像與其真實標註\n",
        "    img_tensor, target = dataset[0]\n",
        "\n",
        "    # 2. 設定模型為評估模式並執行推論\n",
        "    model.eval()\n",
        "    with torch.no_grad():\n",
        "        out = model([img_tensor.to(device)])[0]\n",
        "\n",
        "    # 3. 準備畫布並將 Tensor 轉換為 NumPy 影像格式\n",
        "    fig, ax = plt.subplots(1, 1, figsize=(10, 10))\n",
        "    img_np = img_tensor.permute(1, 2, 0).cpu().numpy()\n",
        "    ax.imshow(img_np)\n",
        "\n",
        "    # --- 繪製綠色實線框：正確答案 (Ground Truth) ---\n",
        "    for box, label in zip(target['boxes'], target['labels']):\n",
        "        x1, y1, x2, y2 = box.cpu().numpy()\n",
        "        rect = patches.Rectangle((x1, y1), x2-x1, y2-y1, linewidth=3, edgecolor='green', facecolor='none')\n",
        "        ax.add_patch(rect)\n",
        "        ax.text(x1, y1-10, f\"GT: {label}\", color='white', fontsize=14, bbox=dict(facecolor='green', alpha=0.7))\n",
        "\n",
        "    # --- 繪製紅色虛線框：原廠模型預測 (Stock Prediction) ---\n",
        "    mask = out['scores'] > 0.3\n",
        "    if mask.sum() == 0:\n",
        "        print(\"警告：這張圖沒有任何高分預測！\")\n",
        "\n",
        "    for box, label, score in zip(out['boxes'][mask], out['labels'][mask], out['scores'][mask]):\n",
        "        x1, y1, x2, y2 = box.cpu().numpy()\n",
        "        rect = patches.Rectangle((x1, y1), x2-x1, y2-y1, linewidth=2, edgecolor='red', facecolor='none', linestyle='--')\n",
        "        ax.add_patch(rect)\n",
        "        # 標示預測類別 ID 與信心分數\n",
        "        ax.text(x1, y2, f\"Pred: {label} ({score:.2f})\", color='white', fontsize=12, bbox=dict(facecolor='red', alpha=0.7))\n",
        "\n",
        "    plt.title(\"Green=Answer | Red=Prediction\", fontsize=16)\n",
        "    plt.show()\n",
        "\n",
        "print(\"正在比較預測位置...\")\n",
        "diagnose_prediction_visual(test_loader.dataset, stock_model_wrapped, device)"
